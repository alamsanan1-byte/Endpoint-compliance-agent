{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "device_id",
    "hostname",
    "os",
    "os_version",
    "collected_at",
    "agent_version",
    "checks"
  ],
  "properties": {
    "device_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "os": {
      "enum": [
        "windows",
        "linux"
      ]
    },
    "os_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "agent_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "value",
          "detail"
        ],
        "properties": {
          "id": {
            "enum": [
              "disk_encryption",
              "patch_level",
              "firewall",
              "antivirus",
              "local_admins",
              "screen_lock",
              "pending_reboot",
              "unauthorised_software"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "warn",
              "error",
              "not_applicable"
            ]
          },
          "value": {},
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "error",
                    "not_applicable"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "null"
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "disk_encryption"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "warn"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "patch_level"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "warn"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "days_since_update"
                  ],
                  "properties": {
                    "days_since_update": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "firewall"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "warn"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "antivirus"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "warn"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled",
                    "definition_age_days"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "definition_age_days": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "local_admins"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "warn"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "members"
                  ],
                  "properties": {
                    "members": {
                      "type": "array",
                      "maxItems": 10000,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "screen_lock"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "warn"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled",
                    "timeout_minutes"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    },
                    "timeout_minutes": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "pending_reboot"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "warn"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "required"
                  ],
                  "properties": {
                    "required": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "id": {
                  "const": "unauthorised_software"
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "warn"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "installed"
                  ],
                  "properties": {
                    "installed": {
                      "type": "array",
                      "maxItems": 10000,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Endpoint raw-fact report v1"
}
